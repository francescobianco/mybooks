# --- SSH target for provision.sh ---
SSH_HOST=books.example.com
SSH_USER=root            # non-root users need passwordless sudo
SSH_PORT=22
#SSH_KEY=~/.ssh/id_ed25519
#SSH_PASS=              # password auth via sshpass (key auth preferred)

# --- mybooks ---
# Single secret: password for the Kobo login AND API key for the agent.
# At least 12 chars; no spaces, quotes, backslash, backtick or $. Generate: openssl rand -base64 18 | tr -d '/'
MYBOOKS_API_KEY=change-me-please
# Public hostname (defaults to the host of MYBOOKS_URL); its DNS must point to SSH_HOST. Caddy gets a Let's Encrypt cert automatically.
#MYBOOKS_DOMAIN=books.example.com
# Base URL used by the coding agent to call the API
MYBOOKS_URL=https://books.example.com

#MYBOOKS_PORT=8080           # internal port, bound to 127.0.0.1
#MYBOOKS_MAX_UPLOAD_MB=512
#MYBOOKS_SESSION_DAYS=90     # how long the Kobo stays logged in
#MYBOOKS_PLAIN_HTTP=1       # also serve http:// without redirect (Kobo browser has no HTTPS)
#MYBOOKS_MANAGE_CADDY=1      # 0 = you run your own proxy towards 127.0.0.1:MYBOOKS_PORT
